package web-shared
version = 0.1.0
authors = "brainfuel"

-- Codegen-agnostic types shared by server (Chez) and client (JS).
-- json (Derive.{ToJSON,FromJSON}) + elab-util (deriving framework).
depends = json, elab-util

sourcedir = "src"
modules =
  Shared.Ids,
  Shared.State,
  Shared.Protocol,
  Generated.Routes
